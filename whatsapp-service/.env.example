# MODULE PROVISOIRE — relais WhatsApp check-in (à retirer après homologation MI).

# Backend Laravel (préfixe API inclus)
LARAVEL_API_BASE=https://checktunisia-backend-production.up.railway.app/api/v1

# Secret partagé — DOIT être identique à WHATSAPP_WORKER_SECRET côté Laravel.
WHATSAPP_WORKER_SECRET=change-me-long-random-secret

# Persistance de la session (survit aux redémarrages sans re-scan du QR).
# En conteneur Railway/Docker : pointer vers un VOLUME PERSISTANT, sinon le QR
# devra être re-scanné à chaque redéploiement (disque éphémère).
WHATSAPP_SESSION_PATH=./.wwebjs_auth

# ── Coffre de session ────────────────────────────────────────────────────────
# Le volume ci-dessus reste le chemin nominal, mais il est attaché à UNE
# instance : il ne survit pas à une recréation du service. Le coffre garde une
# copie chiffrée côté backend (stockage objet des sauvegardes) et la restitue
# au démarrage UNIQUEMENT si le volume n'a pas de session exploitable.
# 0 pour désactiver (déconseillé : la session redevient un exemplaire unique).
WHATSAPP_SESSION_VAULT_ENABLED=1
# Délai après « ready » avant le premier dépôt (laisse WhatsApp Web finir
# d'écrire son profil) puis cadence des dépôts suivants.
WHATSAPP_SESSION_SNAPSHOT_DELAY_MS=180000
WHATSAPP_SESSION_SNAPSHOT_INTERVAL_MS=21600000

# Délai avant de considérer le démarrage bloqué (redémarrage du conteneur ;
# la session est CONSERVÉE). Un démarrage à froid derrière un volume dépasse
# souvent 2 min : ne pas descendre sous 300000.
WHATSAPP_WATCHDOG_MS=420000

# ⚠️ DANGER — autorise l'effacement de la session locale sur blocage au
# démarrage. Laisser VIDE. Ne poser « 1 » que pour un ré-appairage volontaire,
# et le retirer aussitôt après : la session ne se récupère qu'en re-scannant
# un QR sur le téléphone émetteur.
WHATSAPP_ALLOW_SESSION_WIPE=

# Port du endpoint santé local du service Node.
PORT=3001

# Jeton d'accès aux pages sensibles /qr, /debug et /selftest-media (?token=…).
# Long et aléatoire (openssl rand -hex 32). Vide => pages ouvertes (déconseillé :
# quiconque voit le QR peut capter la session). À reporter dans WHATSAPP_QR_URL
# côté backend : https://…/qr?token=<même valeur>
WHATSAPP_QR_TOKEN=

# Cadence de RÉIMPRESSION du QR dans les journaux (ms). WhatsApp régénère le QR
# toutes les ~20 s et chaque impression occupe ~35 lignes : sans throttling, une
# session non appairée évince tout l'historique exploitable des journaux Railway
# en une quinzaine de minutes — c'est ce qui a empêché de reconstituer
# l'incident du 2026-08-08. Le QR reste toujours frais sur la page /qr.
WHATSAPP_QR_LOG_INTERVAL_MS=300000

# Cadence de polling à vide (ms) et backoff en cas d'erreur réseau (ms).
WHATSAPP_IDLE_POLL_MS=5000
WHATSAPP_ERROR_BACKOFF_MS=15000

# Délai dur d'un envoi (ms) : au-delà, la page est réputée muette.
WHATSAPP_SEND_TIMEOUT_MS=120000

# ── Reprise après échec d'envoi (voir recovery.js et le README) ──────────────
# Seuls les échecs imputables à la PAGE WhatsApp Web escaladent. Une photo que
# le backend ne rend pas ou un destinataire refusé ne redémarrent rien : c'est
# ce qui transformait l'incident d'une seule fiche en panne de tout le canal.
#
# Échecs « page » consécutifs avant d'agir.
WHATSAPP_MAX_SEND_FAILURES=3
# Rechargements de page tentés avant de recycler le conteneur (gratuits pour le
# quota de crashs Railway, contrairement à un redémarrage).
WHATSAPP_MAX_PAGE_RELOADS=2
# Plafond de recyclages du conteneur par fenêtre glissante. DOIT rester sous
# restartPolicyMaxRetries (10, cf. railway.json) : au dixième crash Railway
# arrête le service pour de bon — /qr compris, donc plus aucun ré-appairage
# possible.
WHATSAPP_MAX_SELF_RESTARTS=4
WHATSAPP_SELF_RESTART_WINDOW_MS=3600000
# Budget épuisé => veille technique : le worker cesse d'émettre pendant ce délai
# puis retente, sans jamais quitter (/health, /qr et /debug restent joignables).
WHATSAPP_HALT_COOLDOWN_MS=1800000

# Chromium fourni par l'image (optionnel — sinon puppeteer télécharge le sien).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
