FROM php:8.3-cli-alpine

# System dependencies
RUN apk add --no-cache \
    bash curl git unzip libpng-dev libzip-dev oniguruma-dev \
    libjpeg-turbo-dev freetype-dev libwebp-dev \
    postgresql-dev icu-dev libxml2-dev \
    autoconf g++ make \
    # pg_dump 18 + gzip : exercés par les tests de sauvegarde.
    # 18 pour refléter la PRODUCTION (Railway PostgreSQL 18) — la base de test
    # est elle aussi en 18. Tester sur une combinaison de versions qui n'existe
    # nulle part ne prouverait rien.
    postgresql18-client gzip

# PHP extensions (gd is required by the image resizer used in media uploads).
# --with-webp est indispensable : MediaAdminController convertit les médias CMS
# en WebP. Son absence ici alors que l'image de PRODUCTION l'a rendait les deux
# environnements non équivalents — un test vert ne prouvait plus rien sur ce
# chemin.
RUN docker-php-ext-configure gd --with-jpeg --with-freetype --with-webp \
    && docker-php-ext-install \
    pdo pdo_pgsql pgsql \
    zip bcmath mbstring \
    exif pcntl intl gd

# Mémoire : même valeur qu'en production (Dockerfile).
#
# Le défaut de 128 Mo était suffisant tant que la suite ne composait aucun PDF.
# Depuis que le canal Cloud API joint la fiche en pièce jointe, les tests d'envoi
# passent par DomPDF et dépassent ce plafond : la suite mourait sur « Allowed
# memory size exhausted », alors que la PRODUCTION, elle, était déjà relevée.
# Deux environnements qui ne partagent pas leurs limites ne prouvent rien l'un
# de l'autre.
RUN echo "memory_limit=512M" > /usr/local/etc/php/conf.d/memory.ini

# Redis
RUN pecl install redis && docker-php-ext-enable redis

# Composer
COPY --from=composer:2.7 /usr/bin/composer /usr/bin/composer
ENV COMPOSER_ALLOW_SUPERUSER=1

WORKDIR /var/www/html

# Install ALL dependencies (including dev — phpunit, faker, etc.)
COPY composer.json ./
RUN composer install --no-scripts --no-autoloader --no-interaction

# Copy source
COPY . .

RUN composer dump-autoload --optimize

# Storage dirs
RUN mkdir -p storage/framework/cache storage/framework/sessions \
             storage/framework/views storage/logs bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache
