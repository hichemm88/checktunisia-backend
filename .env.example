APP_NAME=Qayed
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Tunis

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qayed
DB_USERNAME=qayed
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@qayed.tn"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:3000

# OCR Service (Phase 2: replace with real service)
OCR_DRIVER=mock
OCR_SERVICE_URL=
OCR_SERVICE_KEY=

# File Storage
PASSPORT_SCAN_DISK=local
PASSPORT_SCAN_ENCRYPTION=true

# ─── MODULE PROVISOIRE — Relais WhatsApp check-in (à retirer après homologation MI) ──
# Voir PROMPT-CLAUDE-CODE-QAYED-AUTORITE.md et whatsapp-service/README.md
# À false : module totalement inerte (aucun enfilage, aucun worker, aucune erreur).
WHATSAPP_POLICE_ENABLED=false
# Destinataire unique, format whatsapp-web.js (jamais en dur dans le code).
WHATSAPP_RECIPIENT=216XXXXXXXX@c.us
# Secret partagé avec le service Node (whatsapp-service/) — long et aléatoire.
WHATSAPP_WORKER_SECRET=
# URL publique de la page /qr du service Node — bouton « Reconnecter » dans
# l'email d'alerte de déconnexion. Si le service Node a un WHATSAPP_QR_TOKEN,
# l'inclure ici : https://wa.qayed.tn/qr?token=<WHATSAPP_QR_TOKEN>
WHATSAPP_QR_URL=

# ─── Tracking des coûts IA (Claude vision) ─────────────────────────────────────
# Secret partagé avec la fonction serverless Vercel (scan CIN / repli passeport)
# pour l'ingestion sur POST /internal/ai-usage — long et aléatoire, même valeur
# que INTERNAL_AI_TRACKING_SECRET côté Vercel. Vide => ingestion refusée (401).
INTERNAL_AI_TRACKING_SECRET=
# Modèle Claude utilisé (aligné sur CIN_SCAN_MODEL côté Vercel) — sert au seed du tarif.
CIN_SCAN_MODEL=claude-sonnet-5

# Subscription grace period (days)
SUBSCRIPTION_GRACE_DAYS=3

# ─── Konnect Payment Gateway (Tunisie) ─────────────────────────────────────────
# Tableau de bord : simulation → https://dashboard.sandbox.konnect.network
#                   production → https://dashboard.konnect.network
# La clé d'API n'est affichée QU'UNE FOIS à sa création — la conserver aussitôt.
#
# Ces variables ne sont qu'un REPLI : la saisie du back-office (Admin →
# Paiements) fait foi, comme pour Flouci.
#
# « sandbox » (simulation) ou « production ». C'est cette valeur qui choisit
# l'URL de l'API — aucune base ne se saisit à la main.
KONNECT_ENV=sandbox
# Format « <idOrganisation>:<secret> ». SECRET.
KONNECT_API_KEY=
# Portefeuille receveur (Dashboard → Wallets).
KONNECT_WALLET_ID=
# Validité du lien de paiement, en MINUTES (Konnect compte en minutes).
KONNECT_LIFESPAN_MINUTES=15
# À true, les frais Konnect s'ajoutent au montant : le client paie plus que le
# TTC facturé et l'encaissement ne correspond plus à la facture.
KONNECT_ADD_FEES_TO_AMOUNT=false
# Formulaire de coordonnées sur la page Konnect. false = on préremplit.
KONNECT_CHECKOUT_FORM=false
# Retours navigateur. Vides = déduits de FRONTEND_URL.
KONNECT_SUCCESS_URL=
KONNECT_FAIL_URL=
# Rappel serveur : segment de chemin secret, long et aléatoire. C'est lui qui
# rend l'URL non devinable — Konnect ne signe pas ses webhooks.
# VIDE = webhook FERMÉ (404) et aucune URL transmise à Konnect. Sans lui, un
# paiement réglé mais dont le client ne revient pas n'est jamais constaté.
# Générer : php -r "echo bin2hex(random_bytes(24));"
KONNECT_WEBHOOK_TOKEN=
# Base publique du webhook si elle diffère d'APP_URL (tunnel en local).
KONNECT_WEBHOOK_URL=

# URL publique du frontend — sert à construire les retours de paiement.
FRONTEND_URL=http://localhost:5173

# ─── Flouci Payment Gateway (Tunisia) — CANAL HISTORIQUE, désactivé ────────────
# Remplacé par Konnect. Conservé pour que les paiements déjà encaissés par ce
# canal restent vérifiables et visibles dans le journal des paiements.
# Obtain from: https://dashboard.flouci.com → Settings → API Keys
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=
FLOUCI_BASE_URL=https://developers.flouci.com/api
# Frontend redirect URLs after payment (Flouci redirects with ?payment_id=xxx)
FLOUCI_SUCCESS_URL=
FLOUCI_FAIL_URL=
# Session timeout in seconds (default 900 = 15 min)
FLOUCI_SESSION_TIMEOUT=900

# ── Suivi des erreurs (Sentry) ────────────────────────────────────────────
# Vide = SDK totalement inerte (cas du local et des tests). Renseigner
# uniquement en production. Le filtrage des données personnelles est dans
# config/sentry.php : ni corps de requête, ni cookies, ni query string.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
# Version déployée, pour rattacher une erreur à un déploiement (ex. SHA git).
SENTRY_RELEASE=
# Traces de performance : 0 = désactivé (volume et coût).
SENTRY_TRACES_SAMPLE_RATE=0

# ── Sonde externe du planificateur (dead-man's switch) ────────────────────
# URL appelée par le planificateur toutes les 5 minutes. L'alarme vit CHEZ LE
# TIERS : c'est lui qui prévient quand les appels CESSENT d'arriver. Aucune
# tâche interne ne peut jouer ce rôle — elle se tairait en même temps que le
# planificateur qu'elle surveille.
#
# Sans elle, la mort du planificateur hors heures ouvrées n'est PAS détectée
# (la file cesse d'être drainée, les fiches ne partent plus, le serveur web
# répond normalement). Vide = sonde inerte, aucun appel sortant.
#
# Ex. Healthchecks.io : https://hc-ping.com/<uuid-du-check>
# L'URL est un JETON : la traiter comme un secret. Voir docs/observabilite.md.
SCHEDULER_PING_URL=

# ── Sauvegardes hors fournisseur (Cloudflare R2) ──────────────────────────
# Bucket chez un fournisseur DIFFÉRENT de celui qui héberge la base : une
# sauvegarde chez le même hébergeur ne protège pas de la perte du compte.
# Production : Cloudflare R2, bucket « qayed-production-backups ».
# Sans BACKUP_S3_BUCKET, « artisan qayed:db-backup » échoue explicitement.
# Voir docs/sauvegardes.md.
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=

# Point de terminaison R2 : https://<id_de_compte>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=

# R2 n'a pas de régions au sens AWS et exige littéralement « auto ».
# Toute autre valeur fait échouer la signature de la requête.
BACKUP_S3_REGION=auto

# R2 sert le bucket dans le CHEMIN, pas en sous-domaine.
BACKUP_S3_PATH_STYLE=true

# Compatibilité R2 : le SDK AWS ≥ 3.337 ajoute un checksum CRC32 par défaut,
# ce qui bascule les envois EN FLUX en encodage « aws-chunked » que R2 ne
# supporte pas. « when_required » évite ce mode. L'intégrité reste garantie
# par le chiffrement authentifié XChaCha20-Poly1305 de l'archive elle-même.
# Ne repasser à « when_supported » que sur un stockage réellement compatible.
BACKUP_S3_CHECKSUM_MODE=when_required

BACKUP_RETENTION_DAYS=30

# Disque de stockage des scans d'identité. « local » = disque privé du
# conteneur (éphémère sur Railway). « s3 » pour un stockage objet durable.
PASSPORT_SCAN_DISK=local

# ── Canal de transmission des fiches (STRAT-07) ───────────────────────────
# 'web' = relais WhatsApp Web non officiel (défaut, comportement historique).
# 'cloud' = API Cloud officielle. Cible AVANT LE 10/09/2026, date
# d'expiration du contournement par pin de version.
# Procédure de bascule : docs/canal-transmission.md
WHATSAPP_CHANNEL=web

# Mode ombre : exerce un second canal À BLANC et journalise les écarts, sans
# rien transmettre. À activer plusieurs jours avant toute bascule.
WHATSAPP_SHADOW_CHANNEL=

WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v21.0

# Coffre de session : garde une copie CHIFFRÉE de l'appairage WhatsApp Web dans
# le stockage objet des sauvegardes (mêmes BACKUP_S3_* et BACKUP_ENCRYPTION_KEY
# — aucune variable supplémentaire). Sans lui, la session ne vit que sur le
# volume d'une instance : sa perte impose de re-scanner un QR sur place.
# Voir docs/session-whatsapp.md
WHATSAPP_SESSION_VAULT_ENABLED=true
# Plancher de refus : une archive plus petite ne peut pas contenir un profil
# appairé. C'est ce qui empêche une session vide d'écraser les credentials.
WHATSAPP_SESSION_VAULT_MIN_BYTES=65536
# Plafond. Doit rester sous post_max_size (Dockerfile : 70M).
WHATSAPP_SESSION_VAULT_MAX_BYTES=67108864

# ── Chiffrement des sauvegardes (obligatoire) ─────────────────────────────
# 32 octets en base64. SECRET. Sans cette clé, la commande REFUSE de produire
# une sauvegarde plutôt que d'en écrire une en clair chez un tiers.
# Générer : php artisan tinker --execute="echo app(\App\Services\Backup\BackupKeyring::class)->generateKey();"
# ⚠️ Perdre cette clé sans l'avoir sauvegardée = perdre toutes les sauvegardes.
BACKUP_ENCRYPTION_KEY=
# Identifiant de la clé courante, écrit en clair dans l'en-tête des archives.
BACKUP_ENCRYPTION_KEY_ID=k1
# Clés retirées du service, conservées pour déchiffrer l'historique.
# Format « k1:base64,k2:base64 ». SECRET. Voir docs/sauvegardes.md (rotation).
BACKUP_ENCRYPTION_PREVIOUS_KEYS=

# Fenêtre de fraîcheur : la tâche tourne toutes les heures et ne travaille que
# si la dernière réussite est plus ancienne que cette valeur.
BACKUP_INTERVAL_HOURS=24
BACKUP_STALE_AFTER_HOURS=26
BACKUP_MIN_FREE_DISK_MB=512
