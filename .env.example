APP_NAME=Qayed
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Tunis

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qayed
DB_USERNAME=qayed
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@qayed.tn"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:3000

# OCR Service (Phase 2: replace with real service)
OCR_DRIVER=mock
OCR_SERVICE_URL=
OCR_SERVICE_KEY=

# File Storage
PASSPORT_SCAN_DISK=local
PASSPORT_SCAN_ENCRYPTION=true

# ─── MODULE PROVISOIRE — Relais WhatsApp check-in (à retirer après homologation MI) ──
# Voir PROMPT-CLAUDE-CODE-QAYED-AUTORITE.md et whatsapp-service/README.md
# À false : module totalement inerte (aucun enfilage, aucun worker, aucune erreur).
WHATSAPP_POLICE_ENABLED=false
# Destinataire unique, format whatsapp-web.js (jamais en dur dans le code).
WHATSAPP_RECIPIENT=216XXXXXXXX@c.us
# Secret partagé avec le service Node (whatsapp-service/) — long et aléatoire.
WHATSAPP_WORKER_SECRET=
# URL publique de la page /qr du service Node — bouton « Reconnecter » dans
# l'email d'alerte de déconnexion. Si le service Node a un WHATSAPP_QR_TOKEN,
# l'inclure ici : https://wa.qayed.tn/qr?token=<WHATSAPP_QR_TOKEN>
WHATSAPP_QR_URL=

# ─── Tracking des coûts IA (Claude vision) ─────────────────────────────────────
# Secret partagé avec la fonction serverless Vercel (scan CIN / repli passeport)
# pour l'ingestion sur POST /internal/ai-usage — long et aléatoire, même valeur
# que INTERNAL_AI_TRACKING_SECRET côté Vercel. Vide => ingestion refusée (401).
INTERNAL_AI_TRACKING_SECRET=
# Modèle Claude utilisé (aligné sur CIN_SCAN_MODEL côté Vercel) — sert au seed du tarif.
CIN_SCAN_MODEL=claude-sonnet-5

# Subscription grace period (days)
SUBSCRIPTION_GRACE_DAYS=3

# ─── Konnect Payment Gateway (Tunisie) ─────────────────────────────────────────
# Tableau de bord : simulation → https://dashboard.sandbox.konnect.network
#                   production → https://dashboard.konnect.network
# La clé d'API n'est affichée QU'UNE FOIS à sa création — la conserver aussitôt.
#
# Ces variables ne sont qu'un REPLI : la saisie du back-office (Admin →
# Paiements) fait foi, comme pour Flouci.
#
# « sandbox » (simulation) ou « production ». C'est cette valeur qui choisit
# l'URL de l'API — aucune base ne se saisit à la main.
KONNECT_ENV=sandbox
# Format « <idOrganisation>:<secret> ». SECRET.
KONNECT_API_KEY=
# Portefeuille receveur (Dashboard → Wallets).
KONNECT_WALLET_ID=
# Validité du lien de paiement, en MINUTES (Konnect compte en minutes).
KONNECT_LIFESPAN_MINUTES=15
# À true, les frais Konnect s'ajoutent au montant : le client paie plus que le
# TTC facturé et l'encaissement ne correspond plus à la facture.
KONNECT_ADD_FEES_TO_AMOUNT=false
# Formulaire de coordonnées sur la page Konnect. false = on préremplit.
KONNECT_CHECKOUT_FORM=false
# Retours navigateur. Vides = déduits de FRONTEND_URL.
KONNECT_SUCCESS_URL=
KONNECT_FAIL_URL=
# Rappel serveur : segment de chemin secret, long et aléatoire. C'est lui qui
# rend l'URL non devinable — Konnect ne signe pas ses webhooks.
# VIDE = webhook FERMÉ (404) et aucune URL transmise à Konnect. Sans lui, un
# paiement réglé mais dont le client ne revient pas n'est jamais constaté.
# Générer : php -r "echo bin2hex(random_bytes(24));"
KONNECT_WEBHOOK_TOKEN=
# Base publique du webhook si elle diffère d'APP_URL (tunnel en local).
KONNECT_WEBHOOK_URL=

# URL publique du frontend — liens des e-mails ET retours de paiement.
# En production : https://qayed.tn (valeur de repli si la variable est absente).
FRONTEND_URL=http://localhost:5173

# ─── WebAuthn / Passkeys (Face ID, Touch ID, Windows Hello, clés FIDO2) ───────
#
# WEBAUTHN_RP_ID doit être le domaine du FRONTEND (celui qui appelle
# navigator.credentials.*), ou un suffixe enregistrable de celui-ci — jamais
# celui de l'API. Frontend sur qayed.tn et API sur api.qayed.tn : la bonne
# valeur est « qayed.tn », et elle couvre alors aussi www.qayed.tn.
#
# ATTENTION : changer ce domaine INVALIDE toutes les passkeys déjà
# enregistrées. Les utilisateurs devraient toutes les recréer.
#
# Vide = déduit de l'hôte de FRONTEND_URL (pratique en local, à poser
# explicitement en production).
WEBAUTHN_RP_ID=
# Nom affiché par le système au moment de Face ID / Touch ID / Windows Hello.
WEBAUTHN_RP_NAME=Qayed
# Origines autorisées à présenter une réponse WebAuthn, séparées par des
# virgules. C'est le rempart anti-hameçonnage : une page servie ailleurs voit
# sa réponse refusée. Aucun joker n'est accepté.
#
# Vide = déduit de FRONTEND_URL, jumeau www/apex compris (https://qayed.tn
# entraîne https://www.qayed.tn, et réciproquement). Une valeur explicite est
# prise TELLE QUELLE : si vous la renseignez, listez-y toutes les formes par
# lesquelles vos utilisateurs arrivent réellement.
# Production : https://qayed.tn,https://www.qayed.tn
WEBAUTHN_ORIGINS=
# Vérification de l'utilisateur : required (défaut) exige la biométrie ou le
# code de l'appareil. Ne l'abaisser (preferred) que si des clés de sécurité
# sans code doivent être acceptées — la passkey ne prouverait alors plus que
# la possession de l'appareil.
WEBAUTHN_USER_VERIFICATION=required
# Durée de vie d'un challenge (secondes) et délai proposé au navigateur (ms).
WEBAUTHN_CHALLENGE_TTL=300
WEBAUTHN_TIMEOUT=120000
# Nombre maximum de passkeys par compte, et codes de récupération remis à
# l'activation de la première passkey.
WEBAUTHN_MAX_CREDENTIALS=10
WEBAUTHN_RECOVERY_CODES=10

# ─── Flouci Payment Gateway (Tunisia) — CANAL HISTORIQUE, désactivé ────────────
# Remplacé par Konnect. Conservé pour que les paiements déjà encaissés par ce
# canal restent vérifiables et visibles dans le journal des paiements.
# Obtain from: https://dashboard.flouci.com → Settings → API Keys
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=
FLOUCI_BASE_URL=https://developers.flouci.com/api
# Frontend redirect URLs after payment (Flouci redirects with ?payment_id=xxx)
FLOUCI_SUCCESS_URL=
FLOUCI_FAIL_URL=
# Session timeout in seconds (default 900 = 15 min)
FLOUCI_SESSION_TIMEOUT=900

# ── Suivi des erreurs (Sentry) ────────────────────────────────────────────
# Vide = SDK totalement inerte (cas du local et des tests). Renseigner
# uniquement en production. Le filtrage des données personnelles est dans
# config/sentry.php : ni corps de requête, ni cookies, ni query string.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
# Version déployée, pour rattacher une erreur à un déploiement (ex. SHA git).
SENTRY_RELEASE=
# Traces de performance : 0 = désactivé (volume et coût).
SENTRY_TRACES_SAMPLE_RATE=0

# ── Sonde externe du planificateur (dead-man's switch) ────────────────────
# URL appelée par le planificateur toutes les 5 minutes. L'alarme vit CHEZ LE
# TIERS : c'est lui qui prévient quand les appels CESSENT d'arriver. Aucune
# tâche interne ne peut jouer ce rôle — elle se tairait en même temps que le
# planificateur qu'elle surveille.
#
# Sans elle, la mort du planificateur hors heures ouvrées n'est PAS détectée
# (la file cesse d'être drainée, les fiches ne partent plus, le serveur web
# répond normalement). Vide = sonde inerte, aucun appel sortant.
#
# Ex. Healthchecks.io : https://hc-ping.com/<uuid-du-check>
# L'URL est un JETON : la traiter comme un secret. Voir docs/observabilite.md.
SCHEDULER_PING_URL=

# ── Sauvegardes hors fournisseur (Cloudflare R2) ──────────────────────────
# Bucket chez un fournisseur DIFFÉRENT de celui qui héberge la base : une
# sauvegarde chez le même hébergeur ne protège pas de la perte du compte.
# Production : Cloudflare R2, bucket « qayed-production-backups ».
# Sans BACKUP_S3_BUCKET, « artisan qayed:db-backup » échoue explicitement.
# Voir docs/sauvegardes.md.
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=

# Point de terminaison R2 : https://<id_de_compte>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=

# R2 n'a pas de régions au sens AWS et exige littéralement « auto ».
# Toute autre valeur fait échouer la signature de la requête.
BACKUP_S3_REGION=auto

# R2 sert le bucket dans le CHEMIN, pas en sous-domaine.
BACKUP_S3_PATH_STYLE=true

# Compatibilité R2 : le SDK AWS ≥ 3.337 ajoute un checksum CRC32 par défaut,
# ce qui bascule les envois EN FLUX en encodage « aws-chunked » que R2 ne
# supporte pas. « when_required » évite ce mode. L'intégrité reste garantie
# par le chiffrement authentifié XChaCha20-Poly1305 de l'archive elle-même.
# Ne repasser à « when_supported » que sur un stockage réellement compatible.
BACKUP_S3_CHECKSUM_MODE=when_required

BACKUP_RETENTION_DAYS=30

# Disque de stockage des scans d'identité. « local » = disque privé du
# conteneur (éphémère sur Railway). « s3 » pour un stockage objet durable.
PASSPORT_SCAN_DISK=local

# ── Canal de transmission des fiches (STRAT-07) ───────────────────────────
# 'cloud' = API Cloud officielle de Meta. DÉFAUT depuis la migration.
# 'web'   = ancien relais WhatsApp Web. Le numéro émetteur a été BANNI : ce
#           canal ne transmet plus rien, il n'est conservé que comme retour
#           arrière d'urgence. WHATSAPP_PROVIDER=legacy est un alias.
# Procédure de bascule : docs/canal-transmission.md
WHATSAPP_CHANNEL=cloud

# Mode ombre : exerce un second canal À BLANC et journalise les écarts, sans
# rien transmettre. À activer plusieurs jours avant toute bascule.
WHATSAPP_SHADOW_CHANNEL=

# ── WhatsApp Cloud API (Meta) ──────────────────────────────────────────────
# UNE SEULE famille de noms : « WHATSAPP_ » + le terme de la console Meta.
# Les anciens WHATSAPP_CLOUD_TOKEN / _PHONE_NUMBER_ID / _WABA_ID / _TEMPLATE /
# _TEMPLATE_LANG ne sont PLUS lus — les supprimer de l'environnement, sans
# quoi on croit avoir configuré le canal en remplissant des variables mortes.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_VERSION=v21.0
# Rarement modifiés (défauts : https://graph.facebook.com et 30 s).
WHATSAPP_API_BASE_URL=
WHATSAPP_API_TIMEOUT=

# Identifiant de l'app Meta — sert à composer le jeton d'application pour
# l'enregistrement du webhook (php artisan whatsapp:configure-webhook).
WHATSAPP_APP_ID=

# Webhook. Le jeton répond au défi de vérification (GET) ; le secret d'app
# signe chaque livraison (X-Hub-Signature-256). SANS le secret, le webhook
# REFUSE toute livraison — un accusé de réception non authentifié falsifierait
# la preuve de transmission d'un document légal.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Laisser vide : déduit de APP_URL (+ /api/v1/webhooks/whatsapp).
WHATSAPP_WEBHOOK_CALLBACK_URL=

# Modèle de message approuvé. Hors fenêtre de 24 h — le cas de toutes les
# fiches — seul un modèle approuvé passe. Voir php artisan whatsapp:templates.
# Ces valeurs doivent correspondre EXACTEMENT au modèle approuvé chez Meta :
# un écart d'une lettre produit un 132001 définitif sur chaque fiche.
# Ce sont aussi les défauts du code : en production, ne rien poser est plus sûr
# que poser une valeur qui pourrait diverger.
WHATSAPP_TEMPLATE_NAME=fiche_police_nouvelle
WHATSAPP_TEMPLATE_LANGUAGE=fr
# Base de l'URL du bouton « Consulter la fiche ». Laisser vide : déduit de
# APP_URL (+ /f/), la route de redirection stable. ATTENTION : cette URL est
# FIGÉE à l'approbation du modèle — la changer impose d'en soumettre un
# nouveau. C'est pourquoi elle ne désigne PAS une page applicative.
WHATSAPP_FICHE_URL_BASE=

# Destination du lien /f/{token}.
#   portal (défaut) : redirection vers la fiche, derrière la connexion du
#                     portail autorité — comportement normal.
#   info            : page statique, sans donnée de fiche ni formulaire. Utile
#                     pendant la fenêtre où le modèle est approuvé (bouton
#                     cliquable) mais le portail pas encore ouvert.
# Toute autre valeur vaut « portal » : le mode dégradé se demande
# explicitement, une faute de frappe ne doit pas éteindre le lien.
WHATSAPP_FICHE_LINK_MODE=

# ── Connexion des agents par code WhatsApp (OTP) ───────────────────────────
# Les agents autorité ont une adresse e-mail FICTIVE : ni mot de passe, ni lien
# d'invitation, ni réinitialisation possible. Leur seul facteur est le
# téléphone sur lequel les fiches arrivent déjà.
#
# Modèle de catégorie AUTHENTICATION. Même règle que WHATSAPP_TEMPLATE_NAME :
# la valeur doit correspondre EXACTEMENT au modèle approuvé chez Meta. Vide =
# le défaut du code (qayed_otp / fr), ce qui est plus sûr que de poser une
# valeur qui pourrait diverger. Créé par php artisan whatsapp:templates --create.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=

# Plafond horaire PROPRE aux codes (défaut 100). La file OTP est séparée de
# celle des fiches : un arriéré de fiches ne doit pas fermer la porte du
# portail, et un afflux de connexions ne doit pas consommer le quota quotidien
# des fiches, qui est une obligation légale. Sans ce plafond, la file OTP
# serait le seul chemin non borné vers Meta.
WHATSAPP_OTP_MAX_PER_HOUR=

# Durée de la session ouverte par code, en jours (défaut 30). Longue à dessein :
# l'agent consulte depuis WhatsApp, sur un téléphone. La contrepartie est la
# révocation par l'admin depuis la fiche de l'agent.
WHATSAPP_OTP_SESSION_DAYS=

# Les bornes de SÉCURITÉ de l'OTP — validité 5 min, 3 essais, verrouillage
# 15 min, 3 demandes par 10 min — n'ont volontairement AUCUNE variable ici.
# Un nombre d'essais relâchable depuis Railway serait une porte dérobée sur le
# portail autorité, ouvrable sans relecture et sans trace dans le dépôt. Elles
# vivent dans config/whatsapp.php, sous la clé « otp ».

# ── Garde-fous d'envoi ─────────────────────────────────────────────────────
# Le numéro émetteur est neuf et la vérification d'entreprise est en cours :
# un pic d'envois vaudrait un bannissement, comme pour le numéro précédent.
# Ces réglages RALENTISSENT la file, ils ne jettent jamais de fiche.

# Coupe-circuit, relu à CHAQUE envoi. false = plus rien ne part, tout reste
# en attente.
WHATSAPP_SENDING_ENABLED=true

# Instant de bascule (ISO 8601). Aucune fiche créée AVANT cet instant ne
# partira, même relancée à la main : c'est la protection contre l'arriéré
# accumulé pendant le bannissement du relais Web.
# NON DÉFINIE = la Cloud API n'envoie RIEN. C'est volontaire : une bascule ne
# doit pas s'armer toute seule au déploiement.
WHATSAPP_CLOUD_API_CUTOVER_AT=

WHATSAPP_MAX_SENDS_PER_MINUTE=20
WHATSAPP_MAX_SENDS_PER_DAY=500

# Garde-fous hérités de la restriction du 17/08/2026 (le numéro avait été
# suspendu 6 h pour « activité laissant penser à du spam »). Ils s'appliquent
# désormais aussi au canal officiel : une suspension y coûterait le numéro
# professionnel vérifié, pas une carte SIM.
WHATSAPP_MAX_PER_HOUR=30
WHATSAPP_MIN_INTERVAL_SECONDS=45
WHATSAPP_INTERVAL_JITTER_RATIO=0.4
WHATSAPP_WARMUP_HOURS=24
WHATSAPP_WARMUP_MAX_PER_HOUR=6
WHATSAPP_WARMUP_MIN_INTERVAL_SECONDS=120
WHATSAPP_CIRCUIT_BREAKER_FAILURES=5

# Au-delà de ce nombre de fiches en attente, l'envoi automatique S'ARRÊTE et
# réclame une action humaine (php artisan whatsapp:allow-backlog). Un arriéré
# est le symptôme d'une panne, pas un volume de travail.
WHATSAPP_BACKLOG_ALERT_THRESHOLD=50

# Pause globale déclenchée par un code Meta de débit ou de qualité.
WHATSAPP_QUALITY_PAUSE_MINUTES=15

# Rapport CSV des fiches annulées par whatsapp:cancel-backlog. Vide =
# storage/app/whatsapp/ (hors dépôt).
WHATSAPP_BACKLOG_REPORT_PATH=

# Coffre de session : garde une copie CHIFFRÉE de l'appairage WhatsApp Web dans
# le stockage objet des sauvegardes (mêmes BACKUP_S3_* et BACKUP_ENCRYPTION_KEY
# — aucune variable supplémentaire). Sans lui, la session ne vit que sur le
# volume d'une instance : sa perte impose de re-scanner un QR sur place.
# Voir docs/session-whatsapp.md
WHATSAPP_SESSION_VAULT_ENABLED=true
# Plancher de refus : une archive plus petite ne peut pas contenir un profil
# appairé. C'est ce qui empêche une session vide d'écraser les credentials.
WHATSAPP_SESSION_VAULT_MIN_BYTES=65536
# Plafond. Doit rester sous post_max_size (Dockerfile : 70M).
WHATSAPP_SESSION_VAULT_MAX_BYTES=67108864

# ── Coûts Meta / WhatsApp (suivi des dépenses) ────────────────────────────
# Meta facture PAR MESSAGE TEMPLATE LIVRÉ depuis juillet 2025, au tarif de la
# catégorie du modèle et du marché du destinataire. Prix USD par message livré,
# marché Tunisie / Rest of Africa. Ces valeurs ne servent qu'à l'ESTIMATION
# locale : dès que `whatsapp:sync-costs` obtient les analytics du WABA, les
# montants réels de Meta la remplacent sur la période.
# Laisser vide = garder le défaut du code (voir config/whatsapp.php).
WHATSAPP_PRICE_UTILITY_USD=
WHATSAPP_PRICE_AUTHENTICATION_USD=
WHATSAPP_PRICE_MARKETING_USD=
# Conversations de service : GRATUITES jusqu'au 30/09/2026, facturées au tarif
# utility à partir du 01/10/2026. Poser la valeur ce jour-là, rien d'autre à
# changer.
WHATSAPP_PRICE_SERVICE_USD=

# Taux de change d'AFFICHAGE uniquement (« ≈ X TND » à côté du montant USD).
# Le stockage reste en USD, comme la facture Meta.
WHATSAPP_USD_TO_TND=

# Synchronisation quotidienne des coûts réels chez Meta (05:00).
# `DAYS` = profondeur de la fenêtre relue à chaque passage : Meta consolide ses
# montants pendant plusieurs jours, ne relire que la veille figerait des
# chiffres provisoires.
WHATSAPP_COST_SYNC_ENABLED=true
WHATSAPP_COST_SYNC_DAYS=7

# ── Chiffrement des sauvegardes (obligatoire) ─────────────────────────────
# 32 octets en base64. SECRET. Sans cette clé, la commande REFUSE de produire
# une sauvegarde plutôt que d'en écrire une en clair chez un tiers.
# Générer : php artisan tinker --execute="echo app(\App\Services\Backup\BackupKeyring::class)->generateKey();"
# ⚠️ Perdre cette clé sans l'avoir sauvegardée = perdre toutes les sauvegardes.
BACKUP_ENCRYPTION_KEY=
# Identifiant de la clé courante, écrit en clair dans l'en-tête des archives.
BACKUP_ENCRYPTION_KEY_ID=k1
# Clés retirées du service, conservées pour déchiffrer l'historique.
# Format « k1:base64,k2:base64 ». SECRET. Voir docs/sauvegardes.md (rotation).
BACKUP_ENCRYPTION_PREVIOUS_KEYS=

# Fenêtre de fraîcheur : la tâche tourne toutes les heures et ne travaille que
# si la dernière réussite est plus ancienne que cette valeur.
BACKUP_INTERVAL_HOURS=24
BACKUP_STALE_AFTER_HOURS=26
BACKUP_MIN_FREE_DISK_MB=512
